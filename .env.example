# PostgreSQL. Для Neon/Supabase: DATABASE_URL — через пулер, DIRECT_URL — прямое подключение (для миграций)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcrm"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mcrm"

# Секрет для подписи сессий: openssl rand -base64 32
AUTH_SECRET="change-me"

# Первый администратор (создаётся командой npm run db:seed, если его ещё нет)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="admin123"
# false — seed создаст только администратора, без демо-телефонов
SEED_DEMO="true"

# Telegram-бот: уведомления + продажа, склад и верификация из чата (токен от @BotFather). Пусто — бот выключен
TELEGRAM_BOT_TOKEN=""
# Адрес сайта: кнопки «Открыть в CRM» в сообщениях и вебхук бота (npm run bot:webhook). Нужен https
APP_URL=""
# Необязательно: свой секрет вебхука. Пусто — выводится из токена бота
TELEGRAM_WEBHOOK_SECRET=""

# Kaspi магазин: секрет для запуска синхронизации заказов по расписанию (GET /api/kaspi/sync с заголовком Authorization: Bearer <секрет>)
CRON_SECRET=""
